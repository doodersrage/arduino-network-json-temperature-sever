// Copy to secrets.h and fill in from Dashboard → Devices → Create push device.
// Do not commit secrets.h.

#pragma once

#define WIFI_SSID "your-wifi"
#define WIFI_PASS "your-password"

// Full URL from the ingest callout, e.g. https://thermaltrace.dev/api/ingest/abc123...
#define INGEST_URL "https://thermaltrace.dev/api/ingest/YOUR_DEVICE_KEY"

// Arduino Uno + Ethernet only (no TLS): optional LAN relay that forwards to INGEST_URL.
// Leave empty when using ESP32/ESP8266 direct HTTPS push.
#define RELAY_HOST ""
#define RELAY_PORT 8080
#define RELAY_PATH "/ingest"
